{
  "name": "kaelix-mcp",
  "version": "0.3.0",
  "description": "MCP adapter for self-hosted Kaelix Dashboard instances.",
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.13.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadowhunter67/kaelix-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/shadowhunter67/kaelix-mcp/issues"
  },
  "homepage": "https://github.com/shadowhunter67/kaelix-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kaelix",
    "ai-agents",
    "self-hosted",
    "dashboard"
  ],
  "bin": {
    "kaelix-mcp": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./tools": "./dist/tools.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node --experimental-strip-types src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepublishOnly": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && npm run test:integration",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "test:integration": "npm run build && node --test test/integration/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.63.0"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
