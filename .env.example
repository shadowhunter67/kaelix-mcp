KAELIX_API_URL=http://localhost:8000/api

# Recommended: set KAELIX_MCP_TOKEN in the dashboard backend's .env, then put
# that same value here so the adapter authenticates via Authorization: Bearer.
# KAELIX_API_TOKEN=replace-with-a-dashboard-generated-mcp-token

# Temporary local fallback for the current cookie-based dashboard auth.
# Copy only the cookie value, not the whole "Cookie:" header.
# Requires KAELIX_ALLOW_COOKIE_AUTH=true (both must be set, or startup fails).
# Ignored entirely whenever KAELIX_API_TOKEN is also set.
# Do not use cookie auth on shared machines, CI, or remote MCP servers.
# KAELIX_ALLOW_COOKIE_AUTH=true
# KAELIX_SESSION_COOKIE=dash_session=...

# Optional: bare integer milliseconds in [1000, 120000]. Default 20000.
# KAELIX_TIMEOUT_MS=20000

# Optional: comma-separated hostname allowlist for non-loopback KAELIX_API_URL
# / redirect targets. Loopback (localhost/127.0.0.1/::1) is always allowed.
# KAELIX_ALLOWED_HOSTS=your-dashboard.example.com

# Optional: "on" always registers kaelix_local_ai_* tools, "off" never does.
# Unset (default) probes /local-ai/status once at startup and enables them
# only if the dashboard backend supports it.
# KAELIX_ENABLE_LOCAL_AI_TOOLS=auto

# Optional: for a dashboard behind a self-signed/internal CA, use Node's
# standard CA trust override when launching the adapter (not a Kaelix-
# specific variable):
# NODE_EXTRA_CA_CERTS=/path/to/ca.pem
